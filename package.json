{
  "name": "radical-browser-desktop",
  "version": "0.3.19",
  "description": "The browser built for builders.",
  "author": "The Radical Party",
  "private": true,
  "main": "build/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "dev": "NODE_ENV=development node build.mjs && electron .",
    "start": "electron .",
    "dist": "npm run typecheck && node build.mjs && electron-builder --mac dmg --arm64 --publish never && electron-builder --mac dmg --x64 --publish never",
    "dist:all": "npm run typecheck && node build.mjs && electron-builder --mac --linux --win --publish never"
  },
  "build": {
    "appId": "com.radicalbrowser.desktop",
    "productName": "Radical Browser",
    "copyright": "Copyright © 2026 Radical Browser",
    "afterSign": "scripts/notarize.js",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "electronLanguages": [
        "en",
        "en-US"
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Radical Browser",
      "icon": "assets/icon.icns",
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "build/**/*",
      "assets/icon.*"
    ],
    "extraFiles": [],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    }
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.1",
    "multicast-dns": "^7.2.5"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/node": "^22.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
